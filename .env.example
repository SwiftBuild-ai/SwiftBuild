PORT=3000

# Optional server mode. Leave DATABASE_URL empty for browser-local workflows.
DATABASE_URL=
SWIFTBUILD_URL=http://localhost:3000
# Generate a secret locally; never commit its value.
SWIFTBUILD_AUTH_SECRET=
# Explicitly allow loopback HTTP only for local development.
SWIFTBUILD_ALLOW_LOCAL_HTTP=0

# Optional organizational sign-in: configure all three settings together.
SWIFTBUILD_OIDC_DISCOVERY_URL=
SWIFTBUILD_OIDC_CLIENT_ID=
SWIFTBUILD_OIDC_CLIENT_SECRET=
