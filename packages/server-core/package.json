{
  "name": "@swiftbuild/server-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "worker": "node --v8-pool-size=2 --import tsx src/dispatcher.ts"
  },
  "dependencies": {
    "@swiftbuild/computation-contracts": "workspace:*",
    "@swiftbuild/architecture-schema": "workspace:*",
    "@swiftbuild/capacity-engine": "workspace:*",
    "@swiftbuild/graph-engine": "workspace:*",
    "@swiftbuild/project-format": "workspace:*",
    "better-auth": "1.7.7",
    "pg": "8.23.1",
    "tsx": "4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swiftbuild/components-core": "workspace:*",
    "@types/pg": "^8.15.6",
    "jose": "6.2.12"
  }
}
