SWIFTBUILD_DB_ADMIN_PASSWORD=replace-with-private-hex-secret
SWIFTBUILD_DB_RUNTIME_PASSWORD=replace-with-separate-private-hex-secret
SWIFTBUILD_AUTH_SECRET=replace-with-stable-private-secret-at-least-32-characters
SWIFTBUILD_COMPUTATION_TOKEN=replace-with-separate-private-secret-at-least-32-characters
SWIFTBUILD_URL=http://localhost:3000
SWIFTBUILD_ALLOW_LOCAL_HTTP=1
SWIFTBUILD_COMPUTATION_IMAGE=swiftbuild-computation-local
