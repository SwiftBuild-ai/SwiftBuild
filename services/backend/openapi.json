  "components": {
    "schemas": {
      "CreateProjectInput": {
        "properties": {
          "workspaceId": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "title": "Workspaceid"
          },
          "operationId": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "title": "Operationid"
          },
          "archive": {
            "title": "Archive"
          },
          "expectedActorId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Expectedactorid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "workspaceId",
          "operationId",
          "archive"
        ],
        "title": "CreateProjectInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvitationInput": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "InvitationInput"
      },
      "JobInput": {
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "title": "Operationid"
          },
          "input": {
            "title": "Input"
          },
          "imported": {
            "type": "boolean",
            "title": "Imported",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId",
          "input"
        ],
        "title": "JobInput"
      },
      "JobOutput": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "projectId": {
            "type": "string",
            "title": "Projectid"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "cancelling",
              "completed",
              "partial",
              "cancelled",
              "failed",
              "timed-out"
            ],
            "title": "State"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          },
          "report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "origin": {
            "type": "string",
            "enum": [
              "computed",
